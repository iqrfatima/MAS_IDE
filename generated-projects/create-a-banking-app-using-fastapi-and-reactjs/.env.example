# Database Configuration
# Used by docker-compose for the 'db' service and by the 'backend' service
POSTGRES_DB=banking_app_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# FastAPI Backend Configuration
# Used by the 'backend' service
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
SECRET_KEY=a_secure_random_key_that_is_at_least_32_bytes_long_and_generated_securely
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration (for development, used for local build outside Docker Compose)
# VITE_API_BASE_URL=http://localhost:8000/api
